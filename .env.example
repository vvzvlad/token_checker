# Copy to .env and fill in real values (`make env` does the copy).
# PLACEHOLDERS ONLY in this file — never commit a real credential, doc id or
# server address. In production these come from the `environment:` block of the
# `crypt-common` stack on nebula, and there is no .env file at all.

# --- Grist (required) --------------------------------------------------------
# Our own Grist deployment holding the Wallets / Settings / Chains tables. No
# defaults in code: the address depends on the deployment, and a missing one must
# fail loudly rather than silently point somewhere wrong.
GRIST_SERVER=https://grist.example.com
GRIST_DOC_ID=your_grist_doc_id_here
GRIST_API_KEY=your_grist_api_key_here

# --- Etherscan (required) ----------------------------------------------------
# Etherscan V2 API key (https://etherscan.io/apidashboard). Used for both the ETH
# and the token balance calls; the chain is chosen per request from the Grist
# `Chains` table, so one key covers every chain.
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- Optional ----------------------------------------------------------------
# Where the watchdog announces that it is killing the process. BOTH have to be
# set or neither: with only one of them the watchdog logs
# "Telegram notification skipped" and dies quietly, which is a supported
# configuration — the container restart and the log line are the primary signal
# either way. Leaving either one commented out, empty or blank all mean the same
# thing, "not configured", and all start the container. A token that IS set is
# checked at startup like the two keys above: the bot token is a credential, it
# travels in the URL, and one too short to be redacted out of an error message is
# refused rather than logged in full later.
# TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
# TELEGRAM_CHAT_ID=-1000000000000

# Port the /health server listens on. The default is a production contract: the
# stack does not pass this variable, and the Dockerfile's HEALTHCHECK curls the
# same default — the probe our Portainer build's auto-heal and auto-update act on.
# Override it only if you also know what the healthcheck will then probe.
# HEALTH_PORT=8080
